{
  "SessionStart": [
    {
      "matcher": "",
      "hooks": [
        {
          "type": "command",
          "command": "python ${CLAUDE_PLUGIN_ROOT}/scripts/print-hook.py ${CLAUDE_PLUGIN_ROOT}/hooks/ralhf-init.md",
          "timeout": 10
        },
        {
          "type": "command",
          "command": "python ${CLAUDE_PLUGIN_ROOT}/scripts/print-hook.py ${CLAUDE_PLUGIN_ROOT}/hooks/extractor-init.md",
          "timeout": 10
        }
      ]
    }
  ],
  "UserPromptSubmit": [
    {
      "matcher": "",
      "hooks": [
        {
          "type": "command",
          "command": "python ${CLAUDE_PLUGIN_ROOT}/scripts/print-hook.py ${CLAUDE_PLUGIN_ROOT}/hooks/user-prompt-gate.md",
          "timeout": 10
        }
      ]
    }
  ],
  "PreToolUse": [
    {
      "matcher": "([Aa]sk|[Qq]uestion|[Cc]larif|[Pp]rompt[Uu]ser)",
      "hooks": [
        {
          "type": "command",
          "command": "python ${CLAUDE_PLUGIN_ROOT}/scripts/print-hook.py ${CLAUDE_PLUGIN_ROOT}/hooks/pretool-askuser-block.json",
          "timeout": 10
        }
      ]
    }
  ],
  "PostToolUse": [
    {
      "matcher": "mcp__.*__(get_wiki_catalog|browse_wiki|batch_fetch)",
      "hooks": [
        {
          "type": "command",
          "command": "python ${CLAUDE_PLUGIN_ROOT}/scripts/track-context-tool.py",
          "timeout": 5
        }
      ]
    },
    {
      "matcher": "mcp__.*__save_context_feedback",
      "hooks": [
        {
          "type": "command",
          "command": "python ${CLAUDE_PLUGIN_ROOT}/scripts/track-feedback-saved.py",
          "timeout": 5
        }
      ]
    }
  ],
  "Stop": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "python ${CLAUDE_PLUGIN_ROOT}/scripts/prompt-context-feedback.py",
          "timeout": 5
        }
      ]
    }
  ],
  "SessionEnd": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "python ${CLAUDE_PLUGIN_ROOT}/scripts/cleanup-session.py",
          "timeout": 5
        }
      ]
    }
  ]
}
