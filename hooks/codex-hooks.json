{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/scripts/print-hook.py ${CLAUDE_PLUGIN_ROOT}/hooks/ralhf-init.md",
            "commandWindows": "py -3 %CLAUDE_PLUGIN_ROOT%\\scripts\\print-hook.py %CLAUDE_PLUGIN_ROOT%\\hooks\\ralhf-init.md",
            "timeout": 10,
            "statusMessage": "Loading RaLHF instructions"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__.*__(get_wiki_catalog|browse_wiki|batch_fetch)",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/scripts/track-context-tool.py",
            "commandWindows": "py -3 %CLAUDE_PLUGIN_ROOT%\\scripts\\track-context-tool.py",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "mcp__.*__save_context_feedback",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/scripts/track-feedback-saved.py",
            "commandWindows": "py -3 %CLAUDE_PLUGIN_ROOT%\\scripts\\track-feedback-saved.py",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/scripts/prompt-context-feedback.py",
            "commandWindows": "py -3 %CLAUDE_PLUGIN_ROOT%\\scripts\\prompt-context-feedback.py",
            "timeout": 5,
            "statusMessage": "Checking RaLHF feedback state"
          }
        ]
      }
    ]
  }
}
